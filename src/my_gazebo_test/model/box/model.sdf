<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="simple_box">
    <static>false</static>

    <link name="box_link">
      <!-- 1. 质量和惯性 -->
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
        </inertia>
      </inertial>

      <!-- 2. 碰撞体（决定物理） -->
      <collision name="collision">
        <geometry>
          <box>
            <size>1 1 1</size>
          </box>
        </geometry>
      </collision>

      <!-- 3. 可视模型（只负责“看见”） -->
      <visual name="visual">
        <geometry>
          <box>
            <size>1 1 1</size>
          </box>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
