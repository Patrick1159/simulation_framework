<launch>
  <arg name="dynamic_scene" default="1" />

  <node pkg="mpc_nav" type="mpc_node.py" name="mpc_node" output="screen">
    <rosparam command="load" file="$(find mpc_nav)/config/mpc.yaml" />
  </node>

  <node pkg="mpc_nav" type="doa_to_obstacles.py" name="doa_adapter" output="screen">
    <param name="target_frame" value="odom"/>
    <param name="max_age" value="0.5"/>
  </node>
  
  <!-- Launch Blank Simulation -->
  <include file="$(find my_tb3_description)/launch/my_tb3_gazebo.launch" />

  <!-- Launch Dynamic Obstacles Scene -->
  <include file="$(find my_tb3_description)/launch/dync_obs.launch">
    <arg name="scene" value="$(arg dynamic_scene)"/>
  </include>

  <!-- Launch Static Obstacles Scene -->
  <!-- <include file="$(find my_tb3_description)/launch/static_obs.launch">
    <arg name="num_obstacles" value="120"/>
    <arg name="xmin" value="1.0"/>
    <arg name="xmax" value="12.0"/>
    <arg name="ymin" value="-6.0"/>
    <arg name="ymax" value="6.0"/>
    <arg name="radius" value="0.2"/>
    <arg name="min_distance" value="0.5"/>
  </include> -->

  <!-- RVIZ -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find mpc_nav)/launch/rviz/mpc.rviz" />
</launch>