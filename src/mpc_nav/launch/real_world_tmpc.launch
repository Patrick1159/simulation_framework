<launch>
  <!--
    Real-World T-MPC Obstacle Avoidance
    ====================================
    Full pipeline: DOA perception + doa_to_tmpc bridge + T-MPC planner.

    Designed for differential-drive robots with a RealSense D400-series
    camera.  No Gazebo or simulation dependencies.

    Usage:
      conda activate fastsam
      source devel/setup.zsh
      roslaunch mpc_nav real_world_tmpc.launch

    Optional args:
      roslaunch mpc_nav real_world_tmpc.launch \
        rgb_topic:=/camera/color/image_raw \
        cmd_vel_topic:=/mobile_base/commands/velocity
  -->

  <!-- ==================================================================
       Sensor Topics
       ================================================================== -->
  <arg name="rgb_topic"           default="/d400/color/image_raw" />
  <arg name="aligned_depth_topic" default="/d400/aligned_depth_to_color/image_raw" />

  <!-- ==================================================================
       Robot State
       ================================================================== -->
  <arg name="odom_topic"          default="/t265/odom/sample" />
  <arg name="odom_frame"          default="odom" />
  <arg name="base_frame"          default="base_link" />
  <arg name="camera_frame"        default="d400_color_optical_frame" />

  <!-- ==================================================================
       Control Output
       ================================================================== -->
  <arg name="cmd_vel_topic"       default="/cmd_vel" />

  <!-- ==================================================================
       Goal Input (rviz "2D Nav Goal" or custom goal publisher)
       ================================================================== -->
  <arg name="goal_topic"          default="/move_base_simple/goal" />

  <!-- ==================================================================
       Global Planning (roadmap + guidance_planner)
       ================================================================== -->
  <arg name="use_global_planner"  default="false" />
  <arg name="map_file"            default="$(find roadmap)/maps/simple_straight.xml" />

  <!-- ==================================================================
       RViz
       ================================================================== -->
  <arg name="use_rviz"            default="true" />
  <arg name="rviz_config"         default="$(find mpc_nav)/launch/rviz/mpc.rviz" />

  <!-- ==================================================================
       Debug / Development
       ================================================================== -->
  <arg name="plan_only"           default="false" />

  <!-- ##################################################################
       DOA PERCEPTION PIPELINE
       ################################################################## -->

  <!-- 1. UMAP: RGB-D -> detection + segmentation -->
  <rosparam command="load" file="$(find umap)/config/simulation.yaml" />

  <node pkg="umap" type="umap_extract" name="umap_node" output="screen">
    <remap from="/camera/aligned_depth_to_color/image_raw" to="$(arg aligned_depth_topic)"/>
    <remap from="/camera/color/image_raw" to="$(arg rgb_topic)"/>
  </node>

  <!-- 2. Coarse match: IoU-based tracking of raw detections -->
  <node pkg="umap" type="coarse_match" name="coarse_match_tracker" output="screen"/>

  <!-- 3. Detailed match: SAM+CLIP feature matching for consistent IDs -->
  <node pkg="umap" type="detailed_match" name="detailed_match_tracker" output="screen"/>

  <!-- 4. Feature extractors: SAM segmentation + CLIP embedding -->
  <node pkg="umap" type="para_samnode.py" name="para_sam_node" output="screen">
    <param name="image_topic" value="$(arg rgb_topic)"/>
  </node>
  <node pkg="umap" type="para_clipnode.py" name="para_clip_node" output="screen">
    <param name="image_topic" value="$(arg rgb_topic)"/>
  </node>
  <node pkg="umap" type="para_aggregate.py" name="para_aggregate_node" output="screen">
    <param name="passthrough_clip" value="true"/>
  </node>

  <!-- 5. Pointcloud: depth -> PointCloud2 in odom frame -->
  <node pkg="pointcloud_generator" type="camera_pose.py" name="d400_pose" output="screen">
    <param name="parent_frame_id" value="$(arg odom_frame)"/>
    <param name="child_frame_id" value="$(arg camera_frame)"/>
  </node>

  <node name="camera_node" pkg="pointcloud_generator" type="processor" output="screen">
    <rosparam file="$(find pointcloud_generator)/param/default_param.yaml" command="load"/>
    <param name="/camera/pointcloud_frame_id" value="$(arg odom_frame)"/>
    <param name="/pointcloud_generate/dynamic_only" value="false"/>
    <param name="/pointcloud_generate/camera/view_field" value="4.0"/>
    <param name="/pointcloud_generate/camera/self_filter" value="0.1"/>
    <param name="/pointcloud_generate/camera/grid_size" value="0.05"/>
    <param name="/pointcloud_generate/camera/eud_range" value="0.01"/>
    <param name="/pointcloud_generate/camera/eud_min_points_num" value="5"/>
    <remap from="/RED/pointcloud_process/camera_pose" to="/camera/current_pose"/>
    <remap from="/RED/pointcloud_process/odom" to="$(arg odom_topic)"/>
    <remap from="/RED/pointcloud_process/color_image" to="$(arg rgb_topic)"/>
    <remap from="/RED/pointcloud_process/depth_image" to="$(arg aligned_depth_topic)"/>
    <remap from="/model_output/obstacles" to="/model_output/obstacles"/>
  </node>

  <!-- ##################################################################
       GLOBAL PLANNER (optional)
       ################################################################## -->

  <group if="$(arg use_global_planner)">
    <node pkg="roadmap" type="roadmap_node" name="roadmap_node" output="screen">
      <param name="map_file" value="$(arg map_file)"/>
    </node>
    <node pkg="guidance_planner" type="example" name="guidance_planner" output="screen"/>
  </group>

  <!-- ##################################################################
       DOA -> T-MPC BRIDGE
       ################################################################## -->
  <node pkg="mpc_nav" type="doa_to_tmpc.py" name="doa_to_tmpc" output="screen">
    <param name="target_frame" value="$(arg odom_frame)"/>
    <param name="N" value="30"/>
    <param name="dt" value="0.2"/>
    <param name="max_age" value="0.2"/>
    <param name="watchdog_timeout" value="0.01"/>
  </node>

  <!-- ##################################################################
       T-MPC PLANNER
       ################################################################## -->
  <node pkg="mpc_planner_jackalsimulator" type="jackalsimulator_planner"
        name="mpc_planner" output="screen" required="true">
    <remap from="/input/state" to="$(arg odom_topic)"/>
    <remap from="/input/goal" to="$(arg goal_topic)"/>
    <remap from="/input/obstacles" to="/doa_obstacles_tmpc"/>
    <remap from="/output/command"
           to="$(eval '/mpc/cmd_vel_blocked' if arg('plan_only') else arg('cmd_vel_topic'))"/>
  </node>

  <!-- ##################################################################
       RViz
       ################################################################## -->
  <node pkg="rviz" type="rviz" name="rviz" if="$(arg use_rviz)"
        args="-d $(arg rviz_config)" />

</launch>
