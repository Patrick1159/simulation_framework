+# Gazebo simulation: horizontal_fov=1.047rad, 640x480
+# fx = fy = (640/2) / tan(1.047/2) = 320 / tan(0.5235) = 554.26
+# cx = 320.0, cy = 240.0  (principal point at image centre)
+depth_intrinsics: [554.26, 554.26, 320.0, 240.0] # fx, fy, cx, cy — Gazebo sim values
