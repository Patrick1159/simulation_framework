 depth_filter_margin: 10 # filter
-depth_skip_pixel: 2  # filter
+depth_skip_pixel: 1  # filter
 image_cols: 640
 image_rows: 480
 body_to_camera: [0.0,  0.0,  1.0,  0.065,
@@ -26,18 +29,18 @@ body_to_camera_color: [0.0,  0.0,  1.0,  0.065,
